PermissionScreen {
    align: center bottom;
}

#objection_input {
    column-span: 2;
}

#dialog {
    grid-size: 2;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

.user_prompt {
    width: 100%;
    text-align: right;
    border: wide grey;
}